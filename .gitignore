# Foundry
out/
cache/

# Dependencies
/contracts/lib/

# Environment: every env file, at any depth (.env.sepolia would hold a deployer key). Only the template is tracked.
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# Claude Code's per-machine approvals (which commands may run without asking). Local by name and by nature: tracked,
# a branch could change what the tool is allowed to do on the machine that checks it out.
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Node / Bun
node_modules/
bun.lockb

# TypeScript
dist/
*.tsbuildinfo

# Next.js
.next/
.vercel/

# Coverage
coverage/
.vercel

# Hermes local backups
_hermes_backups/
.hermes_backups/
hermes_backups/

# Unity WebGL build artifact (built locally via BuildScript.BuildWebGL, deployed with vercel CLI)
apps/web/public/unity-build/

# Guard: a Unity editor opened at packages/ instead of packages/battle-engine/ClawbadaBattle/ writes these here
packages/Library/
packages/Logs/
packages/Temp/
packages/Packages/
packages/ProjectSettings/
packages/UserSettings/

# Unity Performance Testing package scratch, written on every build
packages/battle-engine/ClawbadaBattle/Assets/Resources/PerformanceTestRun*
# Mono crash dumps a batch-mode editor leaves in the project folder when an -executeMethod throws on exit
packages/battle-engine/ClawbadaBattle/mono_crash*

# local e2e run artifacts
scripts/e2e/.runs/
broadcast/
deployments/base-sepolia.json

# Audition-only placeholder audio (candidates not yet chosen, or not cleared to ship) — never in git or LFS, and
# BuildScript.BuildWebGL refuses to ship it without -allowPlaceholderAudio. Drop files at
# Assets/Audio/<Music|SFX>/Resources/Placeholders/ ; BattleMusic falls back to them at runtime.
packages/battle-engine/ClawbadaBattle/Assets/Audio/**/Resources/
packages/battle-engine/ClawbadaBattle/Assets/Audio/**/Resources.meta

# Audio masters (WAV) for scripts/build-music.ts — encoded into apps/web/public/audio/music/, never committed themselves.
audio-masters/

# Browser playtest harness (scripts/harness): per-run output, headless Chrome profile and log
scripts/harness/out/
scripts/harness/chrome-profile/
scripts/harness/chrome-gpu-profile/
scripts/harness/chrome-gpu.log
scripts/harness/chrome.log
scripts/harness/*.out

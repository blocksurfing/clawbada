{
  "name": "@clawbada/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun run test:unit && bun run test:session",
    "test:unit": "bun test src/__tests__/*.test.ts src/__tests__/routes",
    "test:session": "bun test src/__tests__/battle-session",
    "play-practice": "bun run scripts/play-practice.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clawbada/asset-gen": "workspace:*",
    "@clawbada/chain": "workspace:*",
    "@clawbada/logger": "workspace:*",
    "@clawbada/db": "workspace:*",
    "@clawbada/game-logic": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "ioredis": "^5.9.3"
  }
}

# ============================================================================
# Clawbada Environment Variables
# ============================================================================
# Copy to .env and fill in values. Bun loads .env automatically from cwd.
# For local dev, place at monorepo root — all apps inherit it.
# ============================================================================

# ── Database (packages/db → used by api, engine, indexer) ──
DATABASE_URL=postgresql://clawbada:clawbada@localhost:5432/clawbada

# ── Blockchain RPC (packages/chain → used by api, engine, indexer) ──
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Operator wallet — signs season/drand admin txs (mining season rollover,
# drand beacon submission). Required by apps/engine for non-battle paths.
# NEVER commit the real value. Generate with: cast wallet new.
OPERATOR_PRIVATE_KEY=0x

# Battle role-separation keys (Codex cross-cutting HIGH-1).
# Mainnet Configure.s.sol grants MATCHMAKER_ROLE and RESOLVER_ROLE to
# DIFFERENT addresses (see contracts/script/DeployHelpers.s.sol). The
# engine MUST set both keys before mainnet launch — without them, role-
# gated writes will revert on chain.
#   - MATCHMAKER_PRIVATE_KEY signs createBattle from the operator worker.
#   - RESOLVER_PRIVATE_KEY signs advanceRound + settle from the operator
#     worker.
# Off mainnet both fall back to OPERATOR_PRIVATE_KEY when unset, so testnet/dev
# with a single deployer key continues to work. With CHAIN_ENV=mainnet there is
# NO fallback: the engine refuses to start unless all three role keys below are
# set, and all different from each other and from OPERATOR_PRIVATE_KEY — one
# stolen key must never yield two roles (audit 2026-09 D-26).
MATCHMAKER_PRIVATE_KEY=0x
RESOLVER_PRIVATE_KEY=0x
#   - BOOST_ADMIN_PRIVATE_KEY signs the weekly battle-rank boost table
#     (MiningPool.setTeamBoosts / activateBoostEpoch, BOOST_ADMIN_ROLE) from
#     the operator worker. Same OPERATOR_PRIVATE_KEY fallback (off mainnet only).
BOOST_ADMIN_PRIVATE_KEY=0x

# Battle-rank boost epoch clock: unix seconds of the season-1 start. Weekly
# windows are [anchor + 7d·E, anchor + 7d·(E+1)). Shared by api, engine and
# indexer. Falls back to the indexed season-1 start_time when unset.
BOOST_EPOCH_ANCHOR_TS=

# Network mode: set to "mainnet" for production.
# Any other value (or unset) = Base Sepolia testnet.
CHAIN_ENV=testnet
# Indexer cold start: block to backfill from when indexer_state is empty (the deploy block).
# Unset = watch live from the current block only.
INDEXER_START_BLOCK=

# ── API Server (apps/api) ──
API_PORT=3001
# Optional: Redis for multi-instance rate limiting. Omit for in-memory (single instance).
# REDIS_URL=redis://localhost:6379

# ── Game Engine (apps/engine) ──
# drand randomness beacon for battle VRF. Default is League of Entropy quicknet (3 s rounds):
# a staked battle waits for a round emitted AFTER its reveal transaction, so the period is felt
# at every battle start.
DRAND_CHAIN_URL=https://api.drand.sh/52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971

# Master secret for staked-battle randomness (>= 32 chars). REQUIRED in production and must be
# IDENTICAL on apps/api and apps/engine: the engine commits each battle's secret on-chain in
# revealTeams and discloses it in settle, the API plays the battle with it. If the two differ the
# API refuses to start the session and the battle refunds at ACTIVE_WINDOW. Treat it like a
# private key: anyone who holds it can foresee every roll of every live battle. Rotating it is
# safe between battles; a battle revealed under the old value can no longer be settled.
BATTLE_SEED_SECRET=

# V3 live battle sessions (apps/api BattleSessionManager). Turns are played
# off-chain over WebSocket; only settle() reaches the chain (engine settle_battle job).
BATTLE_SESSIONS_ENABLED=true
# Per-turn shot clock; on expiry the lobster auto-Defends (3 consecutive = forfeit).
BATTLE_SHOT_CLOCK_MS=60000
# Practice-bot think delay so turns are readable for humans (agents can set 0).
BOT_THINK_MS=800
# How often the API looks for battles the indexer mirrored to Active (phase 4).
BATTLE_SESSION_POLL_MS=2000
# Engine: how often to look for proposed battles whose dispute window has closed (finalizeBattle).
FINALIZE_POLL_MS=10000
# Breed finalize keeper (apps/engine BreedFinalizeWatcher). requestBreed commits the fee and both
# parents' breed slots at once; the offspring is minted by finalizeBreed, which must land within
# 256 blocks (~8.5 min on Base) or the breed is forfeited. The keeper does that for every
# request, a few seconds after its target block. ALERT on the log line
# "breed request EXPIRED unfinalized": it means the engine was down or behind and a player lost
# a breed.
BREED_FINALIZE_POLL_MS=4000
# Off-chain practice mode vs bots. PRACTICE_PRESETS lets dev environments start a
# practice battle without owning lobsters (defaults to on outside production).
PRACTICE_ENABLED=true
# PRACTICE_PRESETS=true

# ── Frontend (apps/web) ──
# NEXT_PUBLIC_ vars are exposed in the browser — no secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_WC_PROJECT_ID=

# ── Contract Addresses (packages/chain → used by api, engine, indexer) ──
# Populated by: bun run sync-deploy <network>
# Or set manually after deployment.
CLAW_TOKEN_ADDRESS=0x
LOBSTER_NFT_ADDRESS=0x
TEAM_MANAGER_ADDRESS=0x
BREEDING_LAB_ADDRESS=0x
MINING_POOL_ADDRESS=0x
MARKETPLACE_ADDRESS=0x
TREASURY_ADDRESS=0x
FAUCET_ADDRESS=0x
BATTLE_ARENA_ADDRESS=0x
BATTLE_VRF_ADDRESS=0x
EVOLUTION_LAB_ADDRESS=0x
REPAIR_SHOP_ADDRESS=0x

# ── Foundry / Deploy Scripts (forge script) ──
DEPLOYER_PRIVATE_KEY=0x
DEV_WALLET=0x
# TOK-H1: recipient of the 100M genesis Treasury reserve. MUST be a governance
# Safe on mainnet (required, must differ from the deployer) — never the Treasury
# fee-splitter contract, which has no withdrawal path. Falls back to the deployer
# on testnet/local if unset.
TREASURY_RESERVE_ADDRESS=0x
# D-24: recipient of the 125M LP allocation at genesis — the account that will seed the
# Uniswap V3 pool (a Safe, or a hardware wallet used for nothing else). Required on
# mainnet and must differ from the deployer, so the deploy key never holds 12.5% of
# supply at rest. Falls back to the deployer on testnet/local if unset.
# LP_RECIPIENT=
# Role-handoff (Handoff.s.sol, run after Deploy + Configure on mainnet) — TWO phases, see
# docs/runbooks/admin-roles.md: phase 1 grants; the Safe calls Treasury.acceptOwnership()
# (the proof it can sign on this chain); phase 2 (--sig "finalize()") has the deployer renounce.
# GOVERNANCE_SAFE receives DEFAULT_ADMIN on all contracts + MiningPool SEASON_ADMIN +
# Treasury ownership. On mainnet it must be a deployed Safe whose signer threshold is at
# least MIN_SAFE_THRESHOLD (default 3; 1 is never accepted).
# ELIGIBILITY_OPERATOR is the hot service wallet that marks faucet eligibility.
# On mainnet every hot address (matchmaker, resolver, VRF operator, boost admin,
# eligibility operator) must be different from the deployer and from each other, and the
# Safe, the reserve holder and the LP recipient must be none of them (D-26).
GOVERNANCE_SAFE=0x
ELIGIBILITY_OPERATOR=0x
# MIN_SAFE_THRESHOLD=3
# Read-only verification (VerifyDeployment.s.sol) takes the deployer address from
# deployments/<network>.json; override it here if that file is not at hand.
# DEPLOYER_ADDRESS=
# BOOST_ADMIN_ADDRESS is the hot service wallet that posts the weekly battle-rank
# mining boost table (MiningPool.BOOST_ADMIN_ROLE, granted by Configure.s.sol).
# Required + must differ from deployer on mainnet; falls back to deployer on testnet/local.
BOOST_ADMIN_ADDRESS=0x
BASESCAN_API_KEY=

# Sites allowed to request a login signature (EIP-4361 `domain`, host[:port], comma-separated).
# The first entry is the default for agents and scripts, which have no page origin. Unset =
# clawbada-web.vercel.app, plus localhost:3000 outside production. Set this when the web app
# moves to its own domain, or every browser login will be refused.
AUTH_DOMAINS=
# Rollout switch ONLY: also accept the old bare "Clawbada Auth: <ts>" login message. The web app
# (Vercel) and the API (Railway) deploy separately — set to 1, deploy the API, deploy the web
# app, then unset. Leaving it on re-opens audit finding C-01.
AUTH_ALLOW_LEGACY=

# HMAC key for battle session tokens (>= 32 chars). Without it the API mints a per-process
# key, which works but signs every player out whenever the API restarts.
AUTH_SESSION_SECRET=

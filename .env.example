# ============================================================================
# Clawbada Environment Variables
# ============================================================================
# Copy to .env and fill in values. Bun loads .env automatically from cwd.
# For local dev, place at monorepo root — all apps inherit it.
# ============================================================================

# ── Database (packages/db → used by api, engine, indexer) ──
DATABASE_URL=postgresql://clawbada:clawbada@localhost:5432/clawbada

# ── Blockchain RPC (packages/chain → used by api, engine, indexer) ──
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Operator wallet — signs season/drand admin txs (mining season rollover,
# drand beacon submission). Required by apps/engine for non-battle paths.
# NEVER commit the real value. Generate with: cast wallet new.
OPERATOR_PRIVATE_KEY=0x

# Battle role-separation keys (Codex cross-cutting HIGH-1).
# Mainnet Configure.s.sol grants MATCHMAKER_ROLE and RESOLVER_ROLE to
# DIFFERENT addresses (see contracts/script/DeployHelpers.s.sol). The
# engine MUST set both keys before mainnet launch — without them, role-
# gated writes will revert on chain.
#   - MATCHMAKER_PRIVATE_KEY signs createBattle from the operator worker.
#   - RESOLVER_PRIVATE_KEY signs advanceRound + settle from the operator
#     worker.
# Both fall back to OPERATOR_PRIVATE_KEY when unset, so testnet/dev with a
# single deployer key continues to work.
MATCHMAKER_PRIVATE_KEY=0x
RESOLVER_PRIVATE_KEY=0x

# Network mode: set to "mainnet" for production.
# Any other value (or unset) = Base Sepolia testnet.
CHAIN_ENV=testnet

# ── API Server (apps/api) ──
API_PORT=3001
# Optional: Redis for multi-instance rate limiting. Omit for in-memory (single instance).
# REDIS_URL=redis://localhost:6379

# ── Game Engine (apps/engine) ──
# drand randomness beacon for battle VRF. Default works for most cases.
DRAND_CHAIN_URL=https://api.drand.sh

# ── Frontend (apps/web) ──
# NEXT_PUBLIC_ vars are exposed in the browser — no secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_WC_PROJECT_ID=

# ── Contract Addresses (packages/chain → used by api, engine, indexer) ──
# Populated by: bun run sync-deploy <network>
# Or set manually after deployment.
CLAW_TOKEN_ADDRESS=0x
LOBSTER_NFT_ADDRESS=0x
TEAM_MANAGER_ADDRESS=0x
BREEDING_LAB_ADDRESS=0x
MINING_POOL_ADDRESS=0x
MARKETPLACE_ADDRESS=0x
TREASURY_ADDRESS=0x
FAUCET_ADDRESS=0x
BATTLE_ARENA_ADDRESS=0x
BATTLE_VRF_ADDRESS=0x
EVOLUTION_LAB_ADDRESS=0x
REPAIR_SHOP_ADDRESS=0x

# ── Foundry / Deploy Scripts (forge script) ──
DEPLOYER_PRIVATE_KEY=0x
DEV_WALLET=0x
# TOK-H1: recipient of the 100M genesis Treasury reserve. MUST be a governance
# Safe on mainnet (required, must differ from the deployer) — never the Treasury
# fee-splitter contract, which has no withdrawal path. Falls back to the deployer
# on testnet/local if unset.
TREASURY_RESERVE_ADDRESS=0x
# Role-handoff (Handoff.s.sol, run after Deploy + Configure on mainnet):
# GOVERNANCE_SAFE receives DEFAULT_ADMIN on all contracts + MiningPool SEASON_ADMIN +
# Treasury ownership (must differ from deployer; the Safe then calls Treasury.acceptOwnership()).
# ELIGIBILITY_OPERATOR is the hot service wallet that marks faucet eligibility.
GOVERNANCE_SAFE=0x
ELIGIBILITY_OPERATOR=0x
BASESCAN_API_KEY=

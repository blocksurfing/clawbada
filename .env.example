# ============================================================================
# Clawbada Environment Variables
# ============================================================================
# Copy to .env and fill in values. Bun loads .env automatically from cwd.
# For local dev, place at monorepo root — all apps inherit it.
# ============================================================================

# ── Database (packages/db → used by api, engine, indexer) ──
DATABASE_URL=postgresql://clawbada:clawbada@localhost:5432/clawbada

# ── Blockchain RPC (packages/chain → used by api, engine, indexer) ──
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Operator wallet — signs settlement, VRF, matchmaking txs server-side.
# Required by apps/engine and apps/api (battle creation).
# NEVER commit the real value. Generate with: cast wallet new
OPERATOR_PRIVATE_KEY=0x

# Network mode: set to "mainnet" for production.
# Any other value (or unset) = Base Sepolia testnet.
CHAIN_ENV=testnet

# ── API Server (apps/api) ──
API_PORT=3001

# ── Game Engine (apps/engine) ──
# drand randomness beacon for battle VRF. Default works for most cases.
DRAND_CHAIN_URL=https://api.drand.sh

# ── Frontend (apps/web) ──
# NEXT_PUBLIC_ vars are exposed in the browser — no secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_WC_PROJECT_ID=

# ── Foundry / Deploy Scripts (forge script) ──
DEPLOYER_PRIVATE_KEY=0x
DEV_WALLET=0x
BASESCAN_API_KEY=

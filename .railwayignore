# Upload filter for `railway up` (untracked; mirrors docker/.dockerignore intent).
# Drops the 2.5 GB Unity project and local-only artifacts from the upload.
# Root-only entries are anchored with a leading slash — an unanchored `lib` also
# dropped apps/api/src/lib and crashed the first deploy.
.git
node_modules
.next
/packages/battle-engine
/apps/web/public/unity-build
/out
/cache
/lib
/docs
/test
/.vercel
# Local-only build/run artifacts that live under otherwise-needed trees. The browser
# harness leaves a ~180 MB Chrome profile and screenshot dumps under scripts/, and the
# audio masters are gitignored WAVs — together they were enough to time out `railway up`.
/scripts/harness/chrome-profile
/scripts/harness/out
/scripts/harness/chrome.log
/audio-masters

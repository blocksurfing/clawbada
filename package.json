{
  "name": "clawbada",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun run --filter @clawbada/api dev",
    "dev:web": "bun run --filter @clawbada/web dev",
    "dev:engine": "bun run --filter @clawbada/engine dev",
    "dev:indexer": "bun run --filter @clawbada/indexer dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "bun run --filter @clawbada/db generate",
    "db:migrate": "bun run --filter @clawbada/db migrate",
    "db:studio": "bun run --filter @clawbada/db studio",
    "sync-deploy": "bun run scripts/sync-deploy.ts",
    "extract-abis": "bun run packages/chain/scripts/extract-abis.ts",
    "forge:build": "forge build",
    "forge:test": "forge test",
    "prepare": "husky"
  },
  "overrides": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "husky": "^9.1.7",
    "next": "^15.5.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.0"
  }
}
